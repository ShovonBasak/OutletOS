# Copy to .env.prod and fill in all values before deploying.
# Never commit .env.prod to git.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=cp_five_star
POSTGRES_USER=cp_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must be the public-facing URL of the backend API (what the browser calls)
NEXT_PUBLIC_API_BASE=https://yourdomain.com/api

# ── Media storage (DigitalOcean Spaces — recommended) ────────────────────────
# Leave blank to store media files on the server disk (not recommended for prod)
AWS_STORAGE_BUCKET_NAME=your-space-name
AWS_ACCESS_KEY_ID=your-spaces-access-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret-key
AWS_S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=your-space-name.sgp1.cdn.digitaloceanspaces.com

# ── OCR ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
