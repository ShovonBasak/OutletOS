# Copy to .env and adjust. If DATABASE_URL is unset, the project falls back to
# a local SQLite file (backend/db.sqlite3) so it runs with zero config.
# Keep this at least 32 characters (HS256 JWT signing warns below that).
SECRET_KEY=dev-insecure-change-me-not-for-production-use-32b+
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# PostgreSQL (recommended, per spec):
# DATABASE_URL=postgres://cp:cp@localhost:5432/cp_five_star
